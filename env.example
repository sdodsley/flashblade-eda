#
# Environment for run.sh and tests/e2e_*.sh. Copy it to
# $HOME/.flashblade-eda.env (or anywhere, with FBEDA_ENV pointing at it),
# fill in the values and chmod 600 it. env.sh sources it with `set -a`, so
# every assignment is exported. It is shell syntax: quote a value that
# contains spaces or shell metacharacters.

# --- arrays -------------------------------------------------------------------
# The names must match fb_url_env / api_token_env in the vars file and the
# lookup('env', ...) entries in the inventory; vars/example.yml and
# inventory/example.yml use these four. The polling token can hold a
# read-only role; the playbooks authenticate with the same credential.
FB_A_URL=https://flashblade-a.example.com
FB_A_TOKEN=
FB_B_URL=https://flashblade-b.example.com
FB_B_TOKEN=

# --- object store (object_audit.yml, the S3 playbooks) -------------------------
# The S3 data VIP of the array and the access keys of its two audit
# identities. The tail key reads the log bucket (object-list, object-read,
# bucket-list and bucket-info policies: the object-audit source's identity);
# the state key has full access to the eda buckets and writes the cursor
# copy, requests, receipts and legal holds. vars/example.yml names these
# variables in object_audit_arrays and object_store; the plugin and
# playbooks/tasks/s3_object.yml read them from the environment, never from a
# vars file. The array's certificate is self-signed, so the check is off;
# addressing is path-style. One block per array in object_audit_arrays.
FB_A_S3_ENDPOINT=https://flashblade-a-data.example.com
FB_A_S3_ACCESS_KEY=
FB_A_S3_SECRET_KEY=
FB_A_S3_STATE_ACCESS_KEY=
FB_A_S3_STATE_SECRET_KEY=
# A third, full-access key for the lab exit tests only (the demo traffic
# that reads the canary and writes the markers); no rulebook reads it.
#FB_A_S3_APP_ACCESS_KEY=
#FB_A_S3_APP_SECRET_KEY=

# --- webhook secrets ------------------------------------------------------------
# run.sh forwards each of these to ansible-rulebook with --env-vars when it is
# set. Generate a value with: openssl rand -hex 32
# APPROVAL_TOKEN: bearer token the capacity approvals webhook (capacity.yml)
#   and the maintenance-window webhook (maintenance.yml) require; call them
#   with  -H "Authorization: Bearer $APPROVAL_TOKEN"
# GIT_WEBHOOK_SECRET: HMAC secret of the git push webhook (change_control.yml);
#   GitHub signs the body as  X-Hub-Signature-256: sha256=<hex hmac>
APPROVAL_TOKEN=
GIT_WEBHOOK_SECRET=

# --- automation orchestrator (optional) ---------------------------------------
# Client credentials of the orchestrator service account that is bound to the
# EDA triggers (client ids start with nx_sa_; the secret is shown once when the
# credential is created). playbooks/orchestrator_post.yml reads them with
# lookup('env') when orchestrator_enabled is true in the vars file; run.sh
# also forwards them with --env-vars when set. Tokens live 15 minutes and are
# never written to disk. Leave both empty when the orchestrator is not used.
AO_CLIENT_ID=
AO_CLIENT_SECRET=

# --- Slack (optional) --------------------------------------------------------
# Incoming webhook URL of the channel notifications go to. playbooks/notify.yml
# posts every notification there when this is set; the alert log stays the
# record.
SLACK_WEBHOOK_URL=
# Lowest severity notify.yml posts to Slack: info, warning (the default) or
# critical. Every record reaches the alert log whatever this says.
SLACK_MIN_SEVERITY=

# --- optional overrides (defaults shown) ---------------------------------------
#FBEDA_VARS=vars/local-lab.yml
#FBEDA_INVENTORY=inventory/local-lab.yml
#FBEDA_VENV=/path/to/venv                    # default: <repo>/venv
#ANSIBLE_COLLECTIONS_PATH=$HOME/.ansible/collections
